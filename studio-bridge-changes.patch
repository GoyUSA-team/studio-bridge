+    private void installOrRepairRuntime() {
+        if (busy) return;
+        RootFSInstaller.install(this, () -> {
+            executor.execute(() -> {
+                RootFS fs = RootFS.find(this);
+                if (fs.isValid()) {
+                    StudioLoginBridge.patchRootFSKernelbase(fs.getRootDir());
+                }
+                runOnUiThread(() -> {
+                    if (isDestroyed()) return;
+                    refresh();
+                    if (fs.isValid() && containers.isEmpty()) {
+                        createContainer();
+                    }
+                });
+            });
+        });
+    }
