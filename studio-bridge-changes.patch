+            c.setInstanceFollowRedirects(false);c.setConnectTimeout(20000);c.setReadTimeout(30000);
+            c.setRequestProperty("User-Agent","StudioBridge-Experimental/0.1");
+            int status=c.getResponseCode();
+            if(status==200)return c;
