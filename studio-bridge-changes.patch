diff --git a/tests/studiobridge/DeploymentFilesTest.java b/tests/studiobridge/DeploymentFilesTest.java
new file mode 100644
index 0000000..4107b75
--- /dev/null
+++ b/tests/studiobridge/DeploymentFilesTest.java
@@ -0,0 +1,50 @@
+package com.winlator.studiobridge;
+import java.io.*;
+import java.nio.file.*;
+import java.security.MessageDigest;
+import java.util.*;
+import java.util.zip.*;
+public class DeploymentFilesTest {
+    static int checks;
+    interface Op {void run() throws Exception;}
+    static void good(boolean condition,String name){if(!condition)throw new AssertionError(name);checks++;}
+    static void rejects(Op operation,String name)throws Exception{try{operation.run();}catch(IOException expected){checks++;return;}throw new AssertionError("Accepted "+name);}
+    static File zip(File dir,String name,String path,byte[] bytes)throws Exception{
+        File f=new File(dir,name);try(ZipOutputStream out=new ZipOutputStream(new FileOutputStream(f))){out.putNextEntry(new ZipEntry(path));out.write(bytes);out.closeEntry();}return f;
+    }
+    public static void main(String[] args)throws Exception{
+        File root=Files.createTempDirectory("studio-files-test").toFile();
+        try{
+            String manifest="v0\nRobloxStudio.zip\nd41d8cd98f00b204e9800998ecf8427e\n100\n200\n";
+            good(DeploymentFiles.parseManifest(manifest).size()==1,"valid manifest");
+            rejects(()->DeploymentFiles.parseManifest("v1\nx"),"manifest version");
+            rejects(()->DeploymentFiles.parseManifest(manifest.replace("RobloxStudio.zip","../bad.zip")),"unsafe package");
+            rejects(()->DeploymentFiles.parseManifest(manifest.replace("\n100\n","\n-1\n")),"negative size");
+            rejects(()->DeploymentFiles.parseManifest(manifest.replace("d41d8cd98f00b204e9800998ecf8427e","invalid")),"invalid hash");
+            rejects(()->DeploymentFiles.parseManifest(manifest+manifest.substring(3)),"duplicate package");
+            good(DeploymentFiles.safeChild(root,"content/shaders").getPath().startsWith(root.getPath()),"normal child");
+            good(DeploymentFiles.safeChild(root,"").equals(root.getCanonicalFile()),"root destination");
+            for(String path:new String[]{"../escape","a/../../escape","..\\escape","/absolute","C:/absolute"})rejects(()->DeploymentFiles.safeChild(root,path),"traversal "+path);
+            File dest=new File(root,"extract");File okay=zip(root,"good.zip","content/test.txt","hello".getBytes());
+            DeploymentFiles.extract(okay,dest,5,()->{});good(DeploymentFiles.read(new File(dest,"content/test.txt")).equals("hello"),"normal extraction");
+            File rootMarker=zip(root,"root-marker.zip","\\",new byte[0]);
+            DeploymentFiles.extract(rootMarker,new File(root,"root-marker-out"),0,()->{});good(new File(root,"root-marker-out").isDirectory(),"Windows root directory marker");
+            File winDir=zip(root,"windows-dir.zip","\\nested\\",new byte[0]);DeploymentFiles.extract(winDir,new File(root,"win-dir"),0,()->{});good(new File(root,"win-dir/nested").isDirectory(),"Windows rooted directory marker");
+            File badDir=zip(root,"bad-dir.zip","/nested/","payload".getBytes());rejects(()->DeploymentFiles.extract(badDir,dest,100,()->{}),"directory payload");
+            File rooted=zip(root,"rooted.zip","/absolute.txt","bad".getBytes());rejects(()->DeploymentFiles.extract(rooted,dest,100,()->{}),"absolute ZIP file");
+            File evil=zip(root,"evil.zip","../escaped.txt","bad".getBytes());
+            rejects(()->DeploymentFiles.extract(evil,dest,100,()->{}),"ZIP traversal");good(!new File(root,"escaped.txt").exists(),"no outside file");
+            rejects(()->DeploymentFiles.extract(okay,new File(root,"small"),4,()->{}),"ZIP expansion cap");
+            rejects(()->DeploymentFiles.extract(okay,new File(root,"cancelled"),5,()->{throw new InterruptedIOException();}),"cancellation");
+            File empty=new File(root,"empty.zip");Files.write(empty.toPath(),new byte[0]);rejects(()->DeploymentFiles.extract(empty,new File(root,"empty-out"),100,()->{}),"invalid empty ZIP");
+            byte[] pe=new byte[128];pe[0]='M';pe[1]='Z';pe[0x3c]=64;pe[64]='P';pe[65]='E';File exe=new File(root,"test.exe");Files.write(exe.toPath(),pe);good(DeploymentFiles.isPe(exe),"PE signature");
+            pe[64]='X';Files.write(exe.toPath(),pe);good(!DeploymentFiles.isPe(exe),"invalid PE signature");
+            StringBuilder md5=new StringBuilder();for(byte b:MessageDigest.getInstance("MD5").digest(pe))md5.append(String.format("%02x",b&255));
+            DeploymentFiles.PackageInfo info=new DeploymentFiles.PackageInfo("test.exe",md5.toString(),pe.length,pe.length);good(DeploymentFiles.verify(exe,info),"hash and size");
+            pe[1]='X';Files.write(exe.toPath(),pe);good(!DeploymentFiles.verify(exe,info),"corrupt bytes");
+            Files.write(exe.toPath(),new byte[]{0});good(!DeploymentFiles.verify(exe,info),"wrong size");
+            rejects(()->DeploymentFiles.readLimited(new ByteArrayInputStream(new byte[20]),10),"text response size limit");
+            System.out.println("PASS: "+checks+" deployment validation checks");
+        }finally{DeploymentFiles.deleteTree(root);}
+    }
+}
diff --git a/tests/studiobridge/StudioDeploymentTest.java b/tests/studiobridge/StudioDeploymentTest.java
new file mode 100644
index 0000000..b67d32b
--- /dev/null
+++ b/tests/studiobridge/StudioDeploymentTest.java
@@ -0,0 +1,27 @@
+package com.winlator.studiobridge;
+import java.io.*;
+import java.lang.reflect.*;
+import java.nio.channels.*;
+import java.nio.file.*;
+public class StudioDeploymentTest {
+ static int checks;
+ interface Op {void run()throws Exception;}
+ static void rejects(Op op)throws Exception{try{op.run();}catch(IOException e){checks++;return;}throw new AssertionError("Expected rejection");}
+ public static void main(String[] args)throws Exception{
+  File root=Files.createTempDirectory("studio-deploy-validation").toFile();
+  try{
+   StudioDeployment d=new StudioDeployment((s,p)->{});Method open=StudioDeployment.class.getDeclaredMethod("open",String.class);open.setAccessible(true);
+   for(String url:new String[]{"http://setup.rbxcdn.com/x","https://example.com/x","https://setup.rbxcdn.com.example.com/x","https://user:password@setup.rbxcdn.com/x","https://setup.rbxcdn.com:444/x"}){
+    rejects(()->{try{open.invoke(d,url);}catch(InvocationTargetException e){if(e.getCause() instanceof IOException)throw (IOException)e.getCause();throw e;}});
+   }
+   if(StudioDeployment.currentExecutable(root)!=null)throw new AssertionError("No marker should resolve");checks++;
+   File base=StudioDeployment.base(root);DeploymentFiles.mkdir(base);
+   DeploymentFiles.write(new File(base,"current-version.txt"),"../../outside");rejects(()->StudioDeployment.currentExecutable(root));
+   DeploymentFiles.write(new File(base,"current-version.txt"),"version-0000000000000000");if(StudioDeployment.currentExecutable(root)!=null)throw new AssertionError("Missing executable resolved");checks++;
+   try(RandomAccessFile f=new RandomAccessFile(new File(base,"install.lock"),"rw");FileChannel channel=f.getChannel();FileLock lock=channel.lock()){
+    rejects(()->d.install(root,new File(root,"cache")));
+   }
+   System.out.println("PASS: "+checks+" deployment host/marker/locking checks (no network requests)");
+  }finally{DeploymentFiles.deleteTree(root);}
+ }
+}
diff --git a/tests/studiobridge/StudioLoginBridgeTest.java b/tests/studiobridge/StudioLoginBridgeTest.java
new file mode 100644
index 0000000..77a33b2
--- /dev/null
+++ b/tests/studiobridge/StudioLoginBridgeTest.java
@@ -0,0 +1,103 @@
+package com.winlator.studiobridge;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.file.Files;
+
+public class StudioLoginBridgeTest {
+    static int checks;
+    interface Op { void run() throws Exception; }
+
+    static void good(boolean condition, String name) {
+        if (!condition) throw new AssertionError(name);
+        checks++;
+    }
+
+    static void rejects(Op op, String name) throws Exception {
+        try {
+            op.run();
+        } catch (IOException expected) {
+            checks++;
+            return;
+        }
+        throw new AssertionError("Accepted " + name);
+    }
+
+    public static void main(String[] args) throws Exception {
+        File root = Files.createTempDirectory("studio-login-bridge-test").toFile();
+        try {
+            String sample = "roblox-studio-auth:/?code=abc123_def-456%2B789%3D&state=xyz987&client_id=12345";
+            good(StudioLoginBridge.isStudioCallbackUri(sample), "detects roblox-studio-auth URI");
+            good(StudioLoginBridge.isStudioCallbackUri("ROBLOX-STUDIO-AUTH:/?code=1"), "case-insensitive auth URI");
+            good(StudioLoginBridge.isStudioCallbackUri("roblox-studio:1+launchmode:edit"), "detects roblox-studio URI");
+            good(StudioLoginBridge.isStudioCallbackUri("intent:///?code=abc#Intent;scheme=roblox-studio-auth;end"), "detects intent URI");
+            good(!StudioLoginBridge.isStudioCallbackUri("https://authorize.roblox.com/?client_id=1"), "does not treat https as callback");
+
+            good(StudioLoginBridge.isRobloxAuthUrl("https://authorize.roblox.com/?client_id=123"), "detects authorize.roblox.com");
+            good(StudioLoginBridge.isRobloxAuthUrl("https://www.roblox.com/login"), "detects www.roblox.com");
+            good(!StudioLoginBridge.isRobloxAuthUrl("https://evil-roblox.com/login"), "rejects spoofed domain");
+
+            String norm = StudioLoginBridge.normalizeCallbackUri(sample);
+            good(norm.equals(sample), "normalizes standard callback URI");
+
+            String fromIntent = StudioLoginBridge.normalizeCallbackUri("intent:///?code=test123&state=s1#Intent;scheme=roblox-studio-auth;package=com.winlator;end");
+            good(fromIntent.equals("roblox-studio-auth:/?code=test123&state=s1"), "extracts callback URI from Android intent:// URI");
+
+            String escaped = StudioLoginBridge.escapeBatchArg(sample);
+            good(escaped.contains("%%2B") && escaped.contains("%%3D"), "escapes percent signs for Windows batch");
+
+            for (String bad : new String[]{
+                    "",
+                    "https://authorize.roblox.com/",
+                    "roblox-studio-auth:/?code=\"injected\"",
+                    "roblox-studio-auth:/?code=abc\r\ndel C:\\*",
+                    "roblox-studio-auth:/?code=abc`calc`",
+                    "intent:///?code=1#Intent;scheme=http;end"
+            }) {
+                rejects(() -> StudioLoginBridge.normalizeCallbackUri(bad), "malformed/unsafe URI: " + bad);
+            }
+
+            String dosExe = "C:\\StudioBridge\\versions\\version-4f087c32742644ab\\RobloxStudioBeta.exe";
+            String version = "version-4f087c32742644ab";
+            File bat = StudioLoginBridge.writeAuthArtifacts(root, dosExe, version, sample);
+            good(bat.isFile(), "writes studio-auth.bat");
+            String batText = DeploymentFiles.read(bat);
+            good(batText.contains("regedit.exe /s C:\\StudioBridge\\studio-protocol.reg"), "batch imports protocol registry");
+            good(batText.contains("\"" + dosExe + "\" \"" + escaped + "\""), "batch invokes Studio with escaped callback URI");
+
+            File reg = new File(StudioDeployment.base(root), "studio-protocol.reg");
+            good(reg.isFile(), "writes studio-protocol.reg");
+            String regText = DeploymentFiles.read(reg);
+            good(regText.contains("[HKEY_CURRENT_USER\\Software\\Classes\\roblox-studio-auth\\shell\\open\\command]"), "reg defines roblox-studio-auth command");
+            good(regText.contains("winhandler.exe /url"), "reg configures WineBrowser to winhandler.exe /url");
+
+            String d3d11Json = StudioLoginBridge.buildClientAppSettingsJson("D3D11");
+            good(d3d11Json.contains("\"FFlagDebugGraphicsPreferD3D11\": true")
+                    && d3d11Json.contains("\"FFlagDebugGraphicsDisableVulkan\": true"),
+                    "generates D3D11 ClientAppSettings.json");
+
+            String vulkanJson = StudioLoginBridge.buildClientAppSettingsJson("Vulkan");
+            good(vulkanJson.contains("\"FFlagDebugGraphicsPreferVulkan\": true")
+                    && vulkanJson.contains("\"FFlagDebugGraphicsDisableD3D11\": true"),
+                    "generates Vulkan ClientAppSettings.json");
+
+            File kb64 = new File("/tmp/kernelbase.dll");
+            if (kb64.isFile()) {
+                byte[] pe64 = Files.readAllBytes(kb64.toPath());
+                good(StudioLoginBridge.patchKernelbaseBytes(pe64), "patches 64-bit kernelbase.dll with VirtualProtectFromApp");
+                good(!StudioLoginBridge.patchKernelbaseBytes(pe64), "64-bit kernelbase.dll patch is idempotent");
+            }
+
+            File kb32 = new File("/tmp/kernelbase32.dll");
+            if (kb32.isFile()) {
+                byte[] pe32 = Files.readAllBytes(kb32.toPath());
+                good(StudioLoginBridge.patchKernelbaseBytes(pe32), "patches 32-bit kernelbase.dll with VirtualProtectFromApp");
+                good(!StudioLoginBridge.patchKernelbaseBytes(pe32), "32-bit kernelbase.dll patch is idempotent");
+            }
+
+            System.out.println("PASS: " + checks + " login bridge checks");
+        } finally {
+            DeploymentFiles.deleteTree(root);
+        }
+    }
+}
diff --git a/tests/studiobridge/TestLiveDeployment.java b/tests/studiobridge/TestLiveDeployment.java
new file mode 100644
index 0000000..f45a1dc
--- /dev/null
+++ b/tests/studiobridge/TestLiveDeployment.java
@@ -0,0 +1,13 @@
+/* Optional network integration test. Downloads approximately 590 MB at the inspected release.
+   Never executes Studio. Requires org.json and at least several GB of free storage. */
+import com.winlator.studiobridge.*;
+import java.io.File;
+public class TestLiveDeployment {
+ public static void main(String[] args)throws Exception {
+  if(args.length!=2)throw new IllegalArgumentException("Provide a disposable container directory and cache directory");
+  StudioDeployment installer=new StudioDeployment((message,percent)->System.out.println(percent+"% "+message));
+  File container=new File(args[0]);File exe=installer.install(container,new File(args[1]));
+  if(!exe.getCanonicalFile().equals(StudioDeployment.currentExecutable(container)))throw new AssertionError("Current version marker mismatch");
+  System.out.println("PASS: official packages installed and current executable resolved. No Studio execution occurred.");
+ }
+}
