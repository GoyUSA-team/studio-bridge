+/* Studio Bridge additions, 2026. Distributed under LGPL-2.1-or-later. */
+package com.winlator.studiobridge;
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.*;
+import java.util.zip.*;
